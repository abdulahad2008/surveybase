# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Never commit .env.local — it is gitignored.

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses every RLS policy — server-side only, never imported
# into a client component. Used by scripts/seed.mts and src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional display floors for the homepage counters, e.g. while the archive is
# still filling up. A floor, not an override: once the real number is higher,
# the real number wins and the setting stops doing anything. Leave unset to
# show exactly what is in the database. Per-dataset counts are never affected.
STATS_MIN_DATASETS=
STATS_MIN_DOWNLOADS=
